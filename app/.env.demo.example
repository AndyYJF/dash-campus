# 演示实例（展示模式）的环境变量：复制为 .env.demo，只给 compose.demo.yaml 用。说明见 docs/demo-mode.md。
# DEMO_MODE、数据库路径、SETUP_TOKEN 和 SMTP 由 compose.demo.yaml 固定，不在这里配置。

# ===== 应用 =====
# 演示实例对外的地址（正式实例 .env 里的 DEMO_URL 填同一个）
APP_BASE_URL=https://demo.example.org
APP_TIMEZONE=Asia/Shanghai
# 映射到宿主 127.0.0.1 的端口（不要和正式实例的 DASH_PORT 相同）
DEMO_PORT=3001

# ===== 模型 =====
# 访客要和 Agent 对话，这里需要真实模型。建议给演示单独申请一个有额度上限的 key，不要和正式实例共用。
# 留空时演示仍可进入：课表、任务、手动安排等照常，对话与探索会提示未配置模型。
MODEL_PROTOCOL=openai-chat
MODEL_ENDPOINT=
MODEL_NAME=
MODEL_API_KEY=

# ===== 搜索（可选）=====
# 不配时“找候选项目”只能用访客粘贴的资料
SEARCH_PROVIDER=
TAVILY_API_KEY=

# ===== 演示护栏 =====
# 全站每天最多发起多少次模型请求 / 搜索请求（所有访客共用；访客在设置页调高也不会超过）
DEMO_DAILY_MODEL_CALLS=300
DEMO_DAILY_SEARCH_CALLS=20
# 每天几点（APP_TIMEZONE）把数据恢复成初始示例
DEMO_RESET_HOUR=4

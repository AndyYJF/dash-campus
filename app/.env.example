# ===== 应用 =====
# 应用对外基础 URL（用于邮件链接等）
APP_BASE_URL=http://localhost:3000
# 实例时区，默认 Asia/Shanghai
APP_TIMEZONE=Asia/Shanghai
# SQLite 数据库文件路径
DATABASE_PATH=./data/dash-campus.db
# Compose 映射到宿主 127.0.0.1 的端口（默认 3000；宿主端口被占用时改这里）
DASH_PORT=3000
# 一次性初始化 token（POST /setup 使用；初始化完成后不再生效）
SETUP_TOKEN=

# ===== 模型 =====
# 协议标识，如 "openai-chat" / "anthropic-messages" / "fake"（本地 fixture 用）
MODEL_PROTOCOL=
MODEL_ENDPOINT=
MODEL_NAME=
MODEL_API_KEY=

# ===== 搜索 =====
# 首个真实适配器: tavily；未配置时只能使用显式 fixture 或用户粘贴资料
SEARCH_PROVIDER=
TAVILY_API_KEY=

# ===== 邮件 SMTP =====
SMTP_HOST=
SMTP_PORT=587
# implicit（465）/ explicit（587 STARTTLS）/ none。部分 VPS 封 465 出站，改用 587 + explicit
SMTP_TLS_MODE=explicit
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# 唯一主人收件地址
MAIL_TO=

# ===== 展示模式（可选）=====
# 填演示实例的地址后，登录页会多出“进入演示模式”入口。演示实例是另一组容器和数据，见 docs/demo-mode.md。
# 不要在正式实例上设置 DEMO_MODE。
DEMO_URL=
